{%- comment -%}
  Warenkorb (Betonzaun) — native cart page replacing the EComposer cart.

  - Configurator sets (lines with the hidden property _konfig_set) are grouped
    under one heading with the customer's selections and the set total.
    Products added on their own are listed under "Einzelprodukte".
  - "Angebot anfragen" opens the same consultation form as the configurator
    and e-mails the current cart (via Shopify's contact form) as a
    Profi-Montage request.
  - Quantities, removing, notes and the summary update without a page reload
    (Section Rendering API); "Zur Kasse" needs the AGB checkbox.

  One file: paste into sections/main-cart-items.liquid (Dawn's cart section).
{%- endcomment -%}

{%- liquid
  assign accent  = section.settings.accent_color | default: '#e91e8c'
  assign primary = section.settings.primary_color | default: '#0f1d3a'
-%}

<div
  class="bz-cart"
  data-bz-cart
  data-section-id="{{ section.id }}"
  style="--bz-accent: {{ accent }}; --bz-primary: {{ primary }};"
>
  {%- if section.settings.show_steps -%}
    <nav class="bz-steps" aria-label="Bestellschritte">
      <ol>
        <li class="is-active" aria-current="step"><span>1</span>Warenkorb</li>
        <li><span>2</span>Adresse</li>
        <li><span>3</span>Zahlung</li>
        <li><span>4</span>Bestätigung</li>
      </ol>
    </nav>
  {%- endif -%}

  <div class="bz-cart__page">
    {%- if cart.item_count == 0 -%}
      <div class="bz-card bz-empty">
        <h1 class="bz-empty__title">Ihr Warenkorb ist leer</h1>
        <p>Stellen Sie Ihren Zaun im Konfigurator zusammen oder stöbern Sie in unseren Produkten.</p>
        <div class="bz-empty__actions">
          {%- if section.settings.configurator_url != blank -%}
            <a href="{{ section.settings.configurator_url }}" class="bz-btn bz-btn--accent">Zum Konfigurator</a>
          {%- endif -%}
          <a href="{{ routes.all_products_collection_url }}" class="bz-btn bz-btn--ghost">Weiter einkaufen</a>
        </div>
      </div>
    {%- else -%}
      <h1 class="bz-visually-hidden">Warenkorb</h1>

      <form action="{{ routes.cart_url }}" method="post" id="bz-cart-form" class="bz-cart__grid" novalidate>
        <div class="bz-cart__main">
          {%- comment -%}
            ── Products (re-rendered after every change) ──
            One card per configurator set (lines sharing the hidden property
            _konfig_set), then one card for the products added on their own.
          {%- endcomment -%}
          <div class="bz-groups" data-bz-region="lines">
            {%- liquid
              assign set_ids = ','
              assign single_count = 0
              for item in cart.items
                assign sid = item.properties['_konfig_set']
                if sid != blank
                  assign token = ',' | append: sid | append: ','
                  unless set_ids contains token
                    assign set_ids = set_ids | append: sid | append: ','
                  endunless
                else
                  assign single_count = single_count | plus: 1
                endif
              endfor
              assign group_list = set_ids | append: '__single' | split: ','
            -%}

            <div class="bz-groups__bar">
              <p class="bz-groups__count">{{ cart.item_count }} Artikel im Warenkorb</p>
              <button type="button" class="bz-clear" data-bz-clear>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg>
                Warenkorb leeren
              </button>
            </div>

            {%- for group in group_list -%}
              {%- if group == blank -%}{%- continue -%}{%- endif -%}

              {%- if group == '__single' -%}
                {%- if single_count == 0 -%}{%- continue -%}{%- endif -%}
                {%- assign in_set = false -%}
                <section class="bz-group" aria-label="Einzelne Produkte">
                  {%- if set_ids != ',' -%}
                    <header class="bz-group__head">
                      <div class="bz-group__titles">
                        <p class="bz-group__title">Einzelne Produkte</p>
                        <p class="bz-group__sub">Nicht Teil eines konfigurierten Sets</p>
                      </div>
                    </header>
                  {%- endif -%}
              {%- else -%}
                {%- assign in_set = true -%}
                {%- liquid
                  assign set_label = ''
                  assign set_total = 0
                  assign set_count = 0
                  assign set_keys = ''
                  assign info_item = nil
                  assign info_size = 0
                  for it in cart.items
                    if it.properties['_konfig_set'] == group
                      assign set_total = set_total | plus: it.final_line_price
                      assign set_count = set_count | plus: 1
                      assign set_keys = set_keys | append: it.key | append: ','
                      if set_label == blank
                        assign set_label = it.properties['Konfiguration']
                      endif
                      if it.properties.size > info_size
                        assign info_item = it
                        assign info_size = it.properties.size
                      endif
                    endif
                  endfor
                  if set_label == blank
                    assign set_label = 'Konfiguriertes Set'
                  endif
                -%}
                <section class="bz-group bz-group--set" aria-label="{{ set_label | escape }}">
                  <header class="bz-group__head bz-group__head--set">
                    <span class="bz-group__icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="4" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.5"/></svg>
                    </span>
                    <div class="bz-group__titles">
                      <p class="bz-group__title">{{ set_label | escape }}</p>
                      <p class="bz-group__sub">Konfiguriertes Set · {{ set_count }} Positionen · {{ set_total | money_with_currency }}</p>
                    </div>
                    <button type="button" class="bz-group__remove" data-bz-remove-set="{{ set_keys }}">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6M14 11v6"/></svg>
                      Set entfernen
                    </button>
                  </header>

                  {%- if info_item -%}
                    <details class="bz-group__options">
                      <summary>Ihre Auswahl anzeigen</summary>
                      <dl>
                        {%- for property in info_item.properties -%}
                          {%- assign first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and first_char != '_' and property.first != 'Konfiguration' -%}
                            <div>
                              <dt>{{ property.first | escape }}</dt>
                              <dd>{{ property.last | escape }}</dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </dl>
                    </details>
                  {%- endif -%}
              {%- endif -%}

              {%- for item in cart.items -%}
                {%- assign item_set = item.properties['_konfig_set'] | default: '' -%}
                {%- if in_set and item_set != group -%}{%- continue -%}{%- endif -%}
                {%- if in_set == false and item_set != blank -%}{%- continue -%}{%- endif -%}

                <div class="bz-line" data-bz-line="{{ item.key }}">
                  <a href="{{ item.url }}" class="bz-line__media" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 240 }}"
                        alt="{{ item.image.alt | escape }}"
                        width="120"
                        height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                        loading="lazy"
                      >
                    {%- endif -%}
                  </a>

                  <div class="bz-line__info">
                    <a href="{{ item.url }}" class="bz-line__title">{{ item.product.title | escape }}</a>
                    {%- unless item.product.has_only_default_variant -%}
                      {%- for option in item.options_with_values -%}
                        <p class="bz-line__meta">{{ option.name | escape }}: {{ option.value | escape }}</p>
                      {%- endfor -%}
                    {%- endunless -%}
                    {%- unless in_set -%}
                      {%- for property in item.properties -%}
                        {%- assign first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and first_char != '_' -%}
                          <p class="bz-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endunless -%}
                    {%- if item.quantity > 1 -%}
                      <p class="bz-line__meta">{{ item.final_price | money_with_currency }} / Stück</p>
                    {%- endif -%}
                    {%- for discount in item.line_level_discount_allocations -%}
                      <p class="bz-line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
                    {%- endfor -%}
                  </div>

                  <div class="bz-qty">
                    <button type="button" class="bz-qty__btn" data-bz-step="-1" data-bz-key="{{ item.key }}" aria-label="Anzahl verringern">−</button>
                    <input
                      class="bz-qty__input"
                      type="number"
                      min="0"
                      inputmode="numeric"
                      value="{{ item.quantity }}"
                      data-bz-qty="{{ item.key }}"
                      aria-label="Anzahl {{ item.product.title | escape }}"
                    >
                    <button type="button" class="bz-qty__btn" data-bz-step="1" data-bz-key="{{ item.key }}" aria-label="Anzahl erhöhen">+</button>
                  </div>

                  <div class="bz-line__total">
                    {%- if item.original_line_price != item.final_line_price -%}
                      <s class="bz-line__old">{{ item.original_line_price | money }}</s>
                    {%- endif -%}
                    {{ item.final_line_price | money }}
                  </div>

                  <button
                    type="button"
                    class="bz-line__remove"
                    data-bz-remove="{{ item.key }}"
                    aria-label="{{ item.product.title | escape }} entfernen"
                  >
                    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                      <circle cx="12" cy="12" r="9.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
                      <path d="M9 9l6 6M15 9l-6 6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    </svg>
                  </button>

                  <p class="bz-line__error" data-bz-error="{{ item.key }}" role="alert"></p>
                </div>
              {%- endfor -%}
                </section>
            {%- endfor -%}

            <p class="bz-lines__error" data-bz-cart-error role="alert"></p>
          </div>

          {%- comment -%} ── Note to the seller ── {%- endcomment -%}
          <div class="bz-note">
            <label for="bz-cart-note">Besondere Hinweise an den Verkäufer</label>
            <textarea
              id="bz-cart-note"
              name="note"
              rows="6"
              placeholder="Wie können wir Ihnen helfen?"
              data-bz-note
            >{{ cart.note }}</textarea>
          </div>

          {%- comment -%} ── Profi-Montage ── {%- endcomment -%}
          <div class="bz-montage">
            <div class="bz-montage__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="6.5" r="2.5"/><path d="M7 20v-2.5A3.5 3.5 0 0 1 10.5 14h3a3.5 3.5 0 0 1 3.5 3.5V20"/><path d="M4 20h16"/>
              </svg>
            </div>
            <div class="bz-montage__text">
              <p class="bz-montage__title">{{ section.settings.montage_title | escape }}</p>
              <p class="bz-montage__sub">{{ section.settings.montage_text | escape }}</p>
            </div>
            <button type="button" class="bz-btn bz-btn--accent bz-montage__btn" data-bz-open-lead>
              <span aria-hidden="true">+</span> {{ section.settings.montage_button | escape }}
            </button>
          </div>

          {%- comment -%} ── Trust badges ── {%- endcomment -%}
          <ul class="bz-badges" role="list">
            {%- if section.settings.badge_1 != blank -%}
              <li><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#e11d48" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h18v13H3zM3 7l2-4h14l2 4M9 11h6"/></svg>{{ section.settings.badge_1 | escape }}</li>
            {%- endif -%}
            {%- if section.settings.badge_2 != blank -%}
              <li><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.badge_2 | escape }}</li>
            {%- endif -%}
            {%- if section.settings.badge_3 != blank -%}
              <li><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>{{ section.settings.badge_3 | escape }}</li>
            {%- endif -%}
            {%- if section.settings.badge_4 != blank -%}
              <li><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#3b82f6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 21V9l8-6 8 6v12z"/><path d="M9 21v-6h6v6"/></svg>{{ section.settings.badge_4 | escape }}</li>
            {%- endif -%}
          </ul>
        </div>

        <aside class="bz-cart__side">
          {%- comment -%} ── Summary (re-rendered after every change) ── {%- endcomment -%}
          <div class="bz-card bz-summary" data-bz-region="summary">
            <h2 class="bz-summary__title">Zusammenfassung</h2>

            <dl class="bz-summary__rows">
              <div><dt>Zwischensumme</dt><dd>{{ cart.items_subtotal_price | money }}</dd></div>
              <div>
                <dt>Rabatt</dt>
                <dd>− {{ cart.total_discount | money }}</dd>
              </div>
              {%- for application in cart.cart_level_discount_applications -%}
                <div class="bz-summary__code"><dt>{{ application.title | escape }}</dt><dd>− {{ application.total_allocated_amount | money }}</dd></div>
              {%- endfor -%}
              <div>
                {%- if cart.taxes_included -%}
                  <dt>MwSt. (19 %)</dt>
                  <dd class="bz-summary__muted">inkl. {{ cart.total_price | times: 19 | divided_by: 119 | money }}</dd>
                {%- else -%}
                  <dt>MwSt.</dt>
                  <dd class="bz-summary__muted">wird im Checkout berechnet</dd>
                {%- endif -%}
              </div>
            </dl>

            <div class="bz-discount">
              <label for="bz-discount-code">Rabattcode</label>
              <div class="bz-discount__row">
                <input id="bz-discount-code" type="text" placeholder="Gutscheincode eingeben" autocomplete="off" data-bz-discount>
                <button type="button" class="bz-btn bz-btn--primary bz-btn--small" data-bz-apply-discount>Einlösen</button>
              </div>
              <p class="bz-discount__error" data-bz-discount-error role="alert"></p>
            </div>

            <div class="bz-summary__total">
              <span>Gesamtbetrag</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="bz-summary__note">Versandkosten werden im Checkout berechnet</p>

            <label class="bz-agb">
              <input type="checkbox" data-bz-agb>
              <span>
                Ich stimme den
                <a href="{{ section.settings.terms_url | default: '/policies/terms-of-service' }}" target="_blank" rel="noopener">Allgemeinen Geschäftsbedingungen</a>
                zu.
              </span>
            </label>
            <p class="bz-agb__error" data-bz-agb-error role="alert"></p>

            <button type="submit" name="checkout" class="bz-btn bz-btn--primary bz-btn--block bz-checkout">Zur Kasse</button>

            <p class="bz-secure">SSL-verschlüsselt · 100% sicher</p>
            {%- if shop.enabled_payment_types.size > 0 -%}
              <ul class="bz-payments" role="list" aria-label="Zahlungsarten">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          {%- comment -%} ── Shipping estimate ── {%- endcomment -%}
          <div class="bz-card bz-ship">
            <div class="bz-ship__head">
              <span>Versandoptionen</span>
              <button type="button" class="bz-ship__toggle" data-bz-ship-toggle aria-expanded="false">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
                PLZ eingeben
              </button>
            </div>
            <div class="bz-ship__body">
              <div class="bz-ship__form" data-bz-ship-form hidden>
                <input type="text" inputmode="numeric" placeholder="PLZ" aria-label="Postleitzahl" data-bz-ship-zip>
                <select aria-label="Land" data-bz-ship-country>
                  <option value="Germany">Deutschland</option>
                  <option value="Austria">Österreich</option>
                </select>
                <button type="button" class="bz-btn bz-btn--primary bz-btn--small" data-bz-ship-calc>Berechnen</button>
              </div>
              <div class="bz-ship__result" data-bz-ship-result aria-live="polite">
                <p class="bz-ship__hint">Geben Sie Ihre PLZ ein, um Versandoptionen zu sehen.</p>
              </div>
            </div>
          </div>

          {%- comment -%} ── Contact ── {%- endcomment -%}
          {%- if section.settings.phone != blank or section.settings.whatsapp_url != blank -%}
            <div class="bz-card bz-help">
              <p class="bz-help__title">Fragen zur Bestellung?</p>
              {%- if section.settings.phone != blank -%}
                <a class="bz-help__row" href="tel:{{ section.settings.phone | remove: ' ' | remove: '/' | remove: '-' }}">
                  <span class="bz-help__icon bz-help__icon--phone" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>
                  </span>
                  <span><strong>{{ section.settings.phone | escape }}</strong><small>{{ section.settings.phone_hours | escape }}</small></span>
                </a>
              {%- endif -%}
              {%- if section.settings.whatsapp_url != blank -%}
                <a class="bz-help__row" href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">
                  <span class="bz-help__icon bz-help__icon--wa" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5l1-1.5-2-1-1 1a4 4 0 0 1-2-2l1-1-1-2z"/></svg>
                  </span>
                  <span><strong>WhatsApp</strong><small>{{ section.settings.whatsapp_label | escape }}</small></span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </aside>
      </form>
    {%- endif -%}
  </div>

  {%- comment -%} ── Consultation form (Profi-Montage), same as in the configurator ── {%- endcomment -%}
  <div class="bz-modal" data-bz-modal hidden>
    <div class="bz-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="bz-modal-title">
      <div class="bz-modal__head">
        <h2 id="bz-modal-title" data-bz-modal-title>Profi-Montage anfragen</h2>
        <button type="button" class="bz-modal__close" data-bz-close aria-label="Schließen">×</button>
      </div>

      <form class="bz-modal__body" data-bz-lead-form novalidate>
        <p class="bz-modal__intro">
          Wir erstellen Ihnen ein Angebot für die Montage und beraten Sie kostenlos.
          Ihr Warenkorb wird automatisch mitgeschickt.
        </p>

        <div class="bz-modal__cart">
          <button type="button" class="bz-modal__cart-toggle" data-bz-cart-toggle aria-expanded="false">
            <span>Ihr Warenkorb <strong data-bz-cart-total></strong></span>
            <span aria-hidden="true">▼</span>
          </button>
          <div class="bz-modal__cart-list" data-bz-cart-preview hidden></div>
        </div>

        <div class="bz-modal__grid">
          <div class="bz-field">
            <label for="bz-lead-name">Name</label>
            <input id="bz-lead-name" type="text" autocomplete="name" data-bz-field="name">
            <p class="bz-field__error" data-bz-field-error="name"></p>
          </div>
          <div class="bz-field">
            <label for="bz-lead-email">E-Mail</label>
            <input id="bz-lead-email" type="email" autocomplete="email" data-bz-field="email">
            <p class="bz-field__error" data-bz-field-error="email"></p>
          </div>
          <div class="bz-field">
            <label for="bz-lead-phone">Telefon</label>
            <input id="bz-lead-phone" type="tel" autocomplete="tel" data-bz-field="phone">
            <p class="bz-field__error" data-bz-field-error="phone"></p>
          </div>
          <div class="bz-field">
            <label for="bz-lead-plz">Postleitzahl</label>
            <input id="bz-lead-plz" type="text" inputmode="numeric" autocomplete="postal-code" data-bz-field="plz">
            <p class="bz-field__error" data-bz-field-error="plz"></p>
          </div>
        </div>

        <div class="bz-field">
          <label for="bz-lead-message">Ihre Nachricht <span class="bz-optional">(optional)</span></label>
          <textarea
            id="bz-lead-message"
            rows="3"
            placeholder="Wunschtermin, Hanglage, Ecken, Zufahrt für Lieferfahrzeuge?"
            data-bz-field="message"
          ></textarea>
        </div>

        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" class="bz-trap" data-bz-trap>

        <label class="bz-consent" data-bz-consent-box>
          <input type="checkbox" data-bz-field="consent">
          <span>
            Ich habe die
            <a href="{{ section.settings.privacy_url | default: '/policies/privacy-policy' }}" target="_blank" rel="noopener">Datenschutzerklärung</a>
            gelesen und willige ein, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert und
            verarbeitet werden. Ich kann diese Einwilligung jederzeit widerrufen.
          </span>
        </label>
        <p class="bz-field__error" data-bz-field-error="consent"></p>

        <p class="bz-modal__senderror" data-bz-send-error role="alert" hidden></p>

        <button type="submit" class="bz-btn bz-btn--accent bz-btn--block" data-bz-submit>Anfrage senden →</button>
      </form>

      <div class="bz-modal__success" data-bz-success hidden role="status">
        <div class="bz-modal__check" aria-hidden="true">✓</div>
