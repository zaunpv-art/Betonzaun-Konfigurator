<script>
  (function () {
    var root = document.querySelector('[data-bz-cart]');
    if (!root || root.dataset.bzReady) return;
    root.dataset.bzReady = '1';

    var sectionId = root.dataset.sectionId;
    var config = {};
    try { config = JSON.parse(root.querySelector('[data-bz-config]').textContent); } catch (e) {}

    var ADS_SEND_TO   = 'AW-10840469103/NqVECKyCvLAdEO_ckbEo';
    var ATTR_KEY      = 'betonzaun_attribution';     // shared with the configurator
    var TRACKED_KEY   = 'betonzaun_leads_tracked';   // shared with the configurator
    var PENDING_KEY   = 'bz_cart_lead_pending';

    var $  = function (sel, el) { return (el || root).querySelector(sel); };
    var $$ = function (sel, el) { return Array.prototype.slice.call((el || root).querySelectorAll(sel)); };

    function money(cents) {
      return (Number(cents || 0) / 100).toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
    }

    // ════════════════════════════════════════════════════════════════════
    //  Cart updates — quantities, remove line, remove set
    // ════════════════════════════════════════════════════════════════════

    function sectionsToRender() {
      var ids = [sectionId];
      if (document.getElementById('cart-icon-bubble')) ids.push('cart-icon-bubble');
      return ids;
    }

    function applySections(sections) {
      if (!sections) return;
      var html = sections[sectionId];
      if (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        ['lines', 'summary'].forEach(function (name) {
          var fresh = doc.querySelector('[data-bz-region="' + name + '"]');
          var current = root.querySelector('[data-bz-region="' + name + '"]');
          if (fresh && current) current.innerHTML = fresh.innerHTML;
        });
      }
      var bubble = document.getElementById('cart-icon-bubble');
      if (bubble && sections['cart-icon-bubble']) {
        var b = new DOMParser().parseFromString(sections['cart-icon-bubble'], 'text/html').querySelector('.shopify-section');
        if (b) bubble.innerHTML = b.innerHTML;
      }
      restoreSummaryState();
      clearShipping();
    }

    var summaryState = { agb: false, discount: '' };
    function rememberSummaryState() {
      var agb = $('[data-bz-agb]'), code = $('[data-bz-discount]');
      if (agb) summaryState.agb = agb.checked;
      if (code) summaryState.discount = code.value;
    }
    function restoreSummaryState() {
      var agb = $('[data-bz-agb]'), code = $('[data-bz-discount]');
      if (agb) agb.checked = summaryState.agb;
      if (code) code.value = summaryState.discount;
    }

    function showCartError(key, message) {
      var el = key ? root.querySelector('[data-bz-error="' + CSS.escape(key) + '"]') : null;
      (el || $('[data-bz-cart-error]')).textContent = message;
    }

    // updates: { lineKey: quantity }
    function updateCart(updates) {
      rememberSummaryState();
      root.classList.add('is-busy');
      var keys = Object.keys(updates);
      var single = keys.length === 1;
      var body = single
        ? { id: keys[0], quantity: updates[keys[0]] }
        : { updates: updates };
      body.sections = sectionsToRender();
      body.sections_url = window.location.pathname;

      return fetch(window.Shopify && Shopify.routes ? Shopify.routes.root + (single ? 'cart/change.js' : 'cart/update.js') : (single ? '/cart/change.js' : '/cart/update.js'), {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body)
      })
        .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
        .then(function (r) {
          if (!r.ok) {
            // Re-render first (the line shows its real quantity again), then the message
            var message = r.data.description || r.data.message || 'Die Menge konnte nicht geändert werden.';
            return refreshSection().then(function () { showCartError(single ? keys[0] : null, message); });
          }
          if (r.data.item_count === 0) { window.location.reload(); return; }
          applySections(r.data.sections);
          document.dispatchEvent(new CustomEvent('cart:updated', { detail: r.data }));
        })
        .catch(function () { showCartError(null, 'Verbindung fehlgeschlagen. Bitte laden Sie die Seite neu.'); })
        .finally(function () { root.classList.remove('is-busy'); });
    }

    function refreshSection() {
      return fetch(window.location.pathname + '?section_id=' + encodeURIComponent(sectionId))
        .then(function (res) { return res.text(); })
        .then(function (html) { var s = {}; s[sectionId] = html; applySections(s); });
    }

    root.addEventListener('click', function (e) {
      var step = e.target.closest('[data-bz-step]');
      if (step) {
        var key = step.dataset.bzKey;
        var input = root.querySelector('[data-bz-qty="' + CSS.escape(key) + '"]');
        var next = Math.max(0, (parseInt(input.value, 10) || 0) + Number(step.dataset.bzStep));
        input.value = next;
        var u = {}; u[key] = next; updateCart(u);
        return;
      }
      var remove = e.target.closest('[data-bz-remove]');
      if (remove) { var r = {}; r[remove.dataset.bzRemove] = 0; updateCart(r); return; }

      var removeSet = e.target.closest('[data-bz-remove-set]');
      if (removeSet) {
        var all = {};
        removeSet.dataset.bzRemoveSet.split(',').filter(Boolean).forEach(function (k) { all[k] = 0; });
        updateCart(all);
        return;
      }
    });

    // Empty the whole cart (after a confirmation)
    root.addEventListener('click', function (e) {
      if (!e.target.closest('[data-bz-clear]')) return;
      if (!window.confirm('Möchten Sie wirklich alle Artikel aus dem Warenkorb entfernen?')) return;
      root.classList.add('is-busy');
      fetch('/cart/clear.js', { method: 'POST', headers: { Accept: 'application/json' } })
        .then(function () { window.location.reload(); })
        .catch(function () {
          root.classList.remove('is-busy');
          showCartError(null, 'Der Warenkorb konnte nicht geleert werden. Bitte laden Sie die Seite neu.');
        });
    });

    // /cart?bzdebug=1 lists every line with all its properties (also the hidden ones),
    // to check what the configurator really put into the cart
    if (/[?&]bzdebug=1/.test(window.location.search)) {
      fetch('/cart.js', { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (cart) {
          var box = document.createElement('pre');
          box.style.cssText = 'margin:16px auto;max-width:1312px;padding:16px;background:#111;color:#e5e7eb;font:12px/1.5 monospace;white-space:pre-wrap;border-radius:8px';
          box.textContent = 'Warenkorb-Diagnose (' + cart.items.length + ' Positionen)\n\n' + cart.items.map(function (item, i) {
            var props = item.properties || {};
            var keys = Object.keys(props);
            return (i + 1) + '. ' + item.product_title + ' × ' + item.quantity + '\n' +
              (keys.length ? keys.map(function (k) { return '     ' + k + ': ' + props[k]; }).join('\n') : '     (keine Eigenschaften – nicht vom neuen Konfigurator)');
          }).join('\n');
          var page = root.querySelector('.bz-cart__page');
          page.insertBefore(box, page.firstChild);
        });
    }

    var qtyTimer;
    root.addEventListener('change', function (e) {
      var input = e.target.closest('[data-bz-qty]');
      if (!input) return;
      clearTimeout(qtyTimer);
      qtyTimer = setTimeout(function () {
        var u = {}; u[input.dataset.bzQty] = Math.max(0, parseInt(input.value, 10) || 0); updateCart(u);
      }, 250);
    });

    // ════════════════════════════════════════════════════════════════════
    //  Note, discount code, AGB before checkout
    // ════════════════════════════════════════════════════════════════════

    var noteTimer;
    root.addEventListener('input', function (e) {
      if (!e.target.matches('[data-bz-note]')) return;
      clearTimeout(noteTimer);
      var note = e.target.value;
      noteTimer = setTimeout(function () {
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ note: note })
        }).catch(function () {});
      }, 600);
    });

    function applyDiscount() {
      var input = $('[data-bz-discount]');
      var code = (input && input.value || '').trim();
      var err = $('[data-bz-discount-error]');
      if (!code) { if (err) err.textContent = 'Bitte geben Sie einen Gutscheincode ein.'; return; }
      // Shopify applies the code to the session and comes back to the cart
      window.location.href = '/discount/' + encodeURIComponent(code) + '?redirect=' + encodeURIComponent(window.location.pathname);
    }
    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-bz-apply-discount]')) applyDiscount();
    });
    root.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' && e.target.matches('[data-bz-discount]')) { e.preventDefault(); applyDiscount(); }
      if (e.key === 'Enter' && e.target.matches('[data-bz-ship-zip]')) { e.preventDefault(); estimateShipping(); }
      if (e.key === 'Enter' && e.target.matches('[data-bz-qty]')) { e.preventDefault(); e.target.blur(); }
    });

    var form = document.getElementById('bz-cart-form');
    if (form) {
      form.addEventListener('submit', function (e) {
        var agb = $('[data-bz-agb]');
        var err = $('[data-bz-agb-error]');
        if (agb && !agb.checked) {
          e.preventDefault();
          if (err) err.textContent = 'Bitte stimmen Sie den AGB zu, um fortzufahren.';
          agb.closest('.bz-agb').classList.add('has-error');
          agb.focus();
        }
      });
    }
    root.addEventListener('change', function (e) {
      if (!e.target.matches('[data-bz-agb]')) return;
      summaryState.agb = e.target.checked;
      if (e.target.checked) {
        var err = $('[data-bz-agb-error]'); if (err) err.textContent = '';
        e.target.closest('.bz-agb').classList.remove('has-error');
      }
    });

    // ════════════════════════════════════════════════════════════════════
    //  Shipping estimate
    // ════════════════════════════════════════════════════════════════════

    function clearShipping() {
      var out = $('[data-bz-ship-result]');
      if (out && out.dataset.filled) {
        out.innerHTML = '<p class="bz-ship__hint">Warenkorb geändert – bitte Versand neu berechnen.</p>';
        delete out.dataset.filled;
      }
    }

    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-bz-ship-toggle]')) {
        var f = $('[data-bz-ship-form]');
        f.hidden = !f.hidden;
        e.target.closest('[data-bz-ship-toggle]').setAttribute('aria-expanded', String(!f.hidden));
        if (!f.hidden) $('[data-bz-ship-zip]').focus();
      }
      if (e.target.closest('[data-bz-ship-calc]')) estimateShipping();
    });

    function estimateShipping() {
      var zip = ($('[data-bz-ship-zip]').value || '').trim();
      var country = $('[data-bz-ship-country]').value;
      var out = $('[data-bz-ship-result]');
      if (!/^\d{4,5}$/.test(zip)) { out.innerHTML = '<p class="bz-ship__error">Bitte eine gültige PLZ eingeben.</p>'; return; }
      out.innerHTML = '<p class="bz-ship__hint">Versandoptionen werden berechnet…</p>';

      var qs = 'shipping_address%5Bzip%5D=' + encodeURIComponent(zip) + '&shipping_address%5Bcountry%5D=' + encodeURIComponent(country);
      var tries = 0;
      function poll() {
        return fetch('/cart/async_shipping_rates.json?' + qs, { headers: { Accept: 'application/json' } })
          .then(function (res) { return res.json().then(function (j) { return { status: res.status, json: j }; }); })
          .then(function (r) {
            if (r.json && r.json.shipping_rates) return r.json.shipping_rates;
            if (r.status >= 400) throw r.json;
            if (++tries > 12) throw {};
            return new Promise(function (ok) { setTimeout(ok, 700); }).then(poll);
          });
      }

      fetch('/cart/prepare_shipping_rates.json?' + qs, { method: 'POST', headers: { Accept: 'application/json' } })
        .then(function (res) {
          if (res.status === 422) return res.json().then(function (j) { throw j; });
          return poll();
        })
        .then(function (rates) {
          if (!rates.length) {
            out.innerHTML = '<p class="bz-ship__hint">Für diese PLZ ist kein Versand hinterlegt – bitte kontaktieren Sie uns.</p>';
          } else {
            out.innerHTML = '<ul class="bz-ship__rates">' + rates.map(function (rate) {
              var cents = Math.round(parseFloat(rate.price) * 100);
              var price = cents === 0 ? 'kostenlos' : money(cents);
              return '<li><span>' + escapeHtml(rate.name) + '</span><strong>' + price + '</strong></li>';
            }).join('') + '</ul>';
          }
          out.dataset.filled = '1';
        })
        .catch(function (err) {
          var msg = 'Versandkosten konnten nicht berechnet werden. Sie werden im Checkout angezeigt.';
          if (err && typeof err === 'object') {
            var first = Object.keys(err).map(function (k) { return [].concat(err[k]).join(' '); })[0];
            if (first && /zip|plz|postal/i.test(Object.keys(err).join(' '))) msg = 'Diese PLZ wurde nicht erkannt.';
          }
          out.innerHTML = '<p class="bz-ship__error">' + msg + '</p>';
        });
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    // ════════════════════════════════════════════════════════════════════
    //  Profi-Montage request — same form and rules as the configurator
    // ════════════════════════════════════════════════════════════════════

    var modal = $('[data-bz-modal]');
    var leadForm = $('[data-bz-lead-form]');
    var success = $('[data-bz-success]');
    var lastFocus = null;
    var cartSnapshot = null;

    // Click id / campaign tags of the visit (the configurator stores them too)
    (function captureAttribution() {
      try {
        var params = new URLSearchParams(window.location.search);
        var keys = ['gclid', 'gbraid', 'wbraid', 'msclkid', 'fbclid', 'ttclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id'];
        var found = {};
        keys.forEach(function (k) { var v = params.get(k); if (v) found[k] = v.slice(0, 200); });
        if (!Object.keys(found).length) return;
        found.landingPage = window.location.href.slice(0, 500);
        found.referrer = (document.referrer || '').slice(0, 500);
        found.savedAt = Date.now();
        localStorage.setItem(ATTR_KEY, JSON.stringify(found));
      } catch (e) {}
    })();

    function attribution() {
      try {
        var d = JSON.parse(localStorage.getItem(ATTR_KEY) || 'null');
        if (!d || !d.savedAt || Date.now() - d.savedAt > 90 * 864e5) return {};
        var out = {};
        ['gclid', 'gbraid', 'wbraid', 'msclkid', 'fbclid', 'ttclid', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_id'].forEach(function (k) {
          if (d[k]) out[k] = d[k];
        });
        if (d.landingPage) out.landing_page = d.landingPage;
        if (d.referrer) out.referrer = d.referrer;
        out.first_seen = new Date(d.savedAt).toISOString();
        return out;
      } catch (e) { return {}; }
    }

    function fetchCart() {
      return fetch('/cart.js', { headers: { Accept: 'application/json' } }).then(function (r) { return r.json(); });
    }

    // Cart → groups: configurator sets first, then single products
    function groupCart(cart) {
      var sets = [], byId = {}, singles = [];
      (cart.items || []).forEach(function (item) {
        var props = item.properties || {};
        var sid = props._konfig_set;
        if (sid) {
          if (!byId[sid]) { byId[sid] = { label: props['Konfiguration'] || 'Konfiguriertes Set', items: [], options: {}, total: 0 }; sets.push(byId[sid]); }
          var set = byId[sid];
          set.items.push(item);
          set.total += item.final_line_price;
          var visible = Object.keys(props).filter(function (k) { return k.charAt(0) !== '_' && k !== 'Konfiguration' && props[k]; });
          if (visible.length > Object.keys(set.options).length) {
            set.options = {};
            visible.forEach(function (k) { set.options[k] = props[k]; });
          }
        } else {
          singles.push(item);
        }
      });
      return { sets: sets, singles: singles };
    }

    function itemLine(item) {
      var name = item.product_title + (item.variant_title && !item.product_has_only_default_variant ? ' – ' + item.variant_title : '');
      return item.quantity + ' × ' + name + ': ' + money(item.final_line_price);
    }

    function buildCartText(cart) {
      var g = groupCart(cart), lines = [];
      g.sets.forEach(function (set) {
        lines.push('[' + set.label + ']');
        Object.keys(set.options).forEach(function (k) { lines.push('  ' + k + ': ' + set.options[k]); });
        set.items.forEach(function (item) { lines.push('  ' + itemLine(item)); });
        lines.push('  Set-Summe: ' + money(set.total), '');
      });
      if (g.singles.length) {
        if (g.sets.length) lines.push('[Einzelprodukte]');
        g.singles.forEach(function (item) {
          lines.push((g.sets.length ? '  ' : '') + itemLine(item));
          var props = item.properties || {};
          Object.keys(props).forEach(function (k) { if (k.charAt(0) !== '_' && props[k]) lines.push((g.sets.length ? '    ' : '  ') + k + ': ' + props[k]); });
        });
        lines.push('');
      }
      lines.push('Warenkorb-Summe: ' + money(cart.total_price) + ' (inkl. MwSt., zzgl. Versand)');
      if (cart.total_discount) lines.push('Darin Rabatt: ' + money(cart.total_discount));
      if (cart.note) lines.push('', 'Hinweis an den Verkäufer (Warenkorb):', cart.note);
      return lines.join('\n');
    }

    function renderPreview(cart) {
      var g = groupCart(cart), html = '';
      g.sets.forEach(function (set) {
        html += '<p class="is-set"><span>' + escapeHtml(set.label) + '</span><span>' + money(set.total) + '</span></p>';
        set.items.forEach(function (item) { html += '<p><span>' + item.quantity + ' × ' + escapeHtml(item.product_title) + '</span><span>' + money(item.final_line_price) + '</span></p>'; });
      });
      if (g.singles.length) {
        if (g.sets.length) html += '<p class="is-set"><span>Einzelprodukte</span><span></span></p>';
        g.singles.forEach(function (item) { html += '<p><span>' + item.quantity + ' × ' + escapeHtml(item.product_title) + '</span><span>' + money(item.final_line_price) + '</span></p>'; });
      }
      $('[data-bz-cart-preview]').innerHTML = html;
      $('[data-bz-cart-total]').textContent = '· ' + money(cart.total_price);
    }

    function openModal(sent, email) {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      leadForm.hidden = !!sent;
      success.hidden = !sent;
      $('[data-bz-modal-title]').textContent = sent ? 'Vielen Dank für Ihre Anfrage' : 'Profi-Montage anfragen';
      if (sent) {
        $('[data-bz-success-email]').textContent = email ? 'unter ' + email : '';
        success.querySelector('button').focus();
      } else {
        $('[data-bz-send-error]').hidden = true;
        fetchCart().then(function (cart) { cartSnapshot = cart; renderPreview(cart); }).catch(function () {});
        setTimeout(function () { var f = $('[data-bz-field="name"]'); if (f) f.focus(); }, 50);
      }
    }

    function closeModal() {
      modal.hidden = true;
      document.documentElement.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-bz-open-lead]')) { e.preventDefault(); openModal(false); }
      if (e.target.closest('[data-bz-close]')) closeModal();
      if (e.target === modal) closeModal();
      if (e.target.closest('[data-bz-cart-toggle]')) {
        var list = $('[data-bz-cart-preview]'), t = e.target.closest('[data-bz-cart-toggle]');
        list.hidden = !list.hidden;
        t.setAttribute('aria-expanded', String(!list.hidden));
      }
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
    });

    function value(name) {
      var el = $('[data-bz-field="' + name + '"]');
      return el.type === 'checkbox' ? el.checked : el.value.trim();
    }

    function validate() {
      var errors = {};
      if (value('name').length < 2) errors.name = 'Bitte geben Sie Ihren Namen an.';
      if (!/^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/.test(value('email'))) errors.email = 'Bitte geben Sie eine gültige E-Mail-Adresse an.';
      if (value('phone').replace(/\D/g, '').length < 6) errors.phone = 'Bitte geben Sie Ihre Telefonnummer an.';
      if (!/^\d{4,5}$/.test(value('plz'))) errors.plz = 'Bitte geben Sie Ihre Postleitzahl an.';
      if (!value('consent')) errors.consent = 'Bitte stimmen Sie der Datenschutzerklärung zu.';

      ['name', 'email', 'phone', 'plz', 'consent'].forEach(function (k) {
        $('[data-bz-field-error="' + k + '"]').textContent = errors[k] || '';
        var el = $('[data-bz-field="' + k + '"]');
        if (k === 'consent') $('[data-bz-consent-box]').classList.toggle('has-error', !!errors[k]);
        else el.classList.toggle('is-invalid', !!errors[k]);
        el.setAttribute('aria-invalid', errors[k] ? 'true' : 'false');
      });
      var first = ['name', 'email', 'phone', 'plz', 'consent'].filter(function (k) { return errors[k]; })[0];
      if (first) $('[data-bz-field="' + first + '"]').focus();
      return !first;
    }

    // Fire the Google Ads conversion once per request, only after a confirmed send
    function trackLead(requestId, total) {
      if (!config.trackConversion) return;
      try {
        var ids = JSON.parse(sessionStorage.getItem(TRACKED_KEY) || '[]');
        if (ids.indexOf(requestId) !== -1) return;
        sessionStorage.setItem(TRACKED_KEY, JSON.stringify(ids.concat(requestId).slice(-20)));
      } catch (e) {}
      var value = Math.round((Number(total) || 0) / 100 * 0.2) || 100;
      if (typeof window.gtag === 'function') {
        try { window.gtag('event', 'conversion', { send_to: ADS_SEND_TO, value: value, currency: 'EUR', transaction_id: requestId }); } catch (e) {}
      } else {
        try { window.Shopify && Shopify.analytics && Shopify.analytics.publish && Shopify.analytics.publish('configurator_request_sent', { value: value, request_id: requestId }); } catch (e) {}
      }
      try { window.dispatchEvent(new CustomEvent('betonzaun:lead-submitted', { detail: { konfigurator: 'Warenkorb', lead_value: value, request_id: requestId } })); } catch (e) {}
    }

    function shopifyFields(data, cartText) {
      var fields = [
        ['form_type', 'contact'],
        ['utf8', '✓'],
        ['contact[name]', data.name],
        ['contact[email]', data.email],
        ['contact[phone]', data.phone],
        ['contact[Postleitzahl]', data.plz],
        ['contact[Anfrage]', config.requestLabel || 'Profi-Montage-Anfrage aus dem Warenkorb']
      ];
      var body = ['ANFRAGE', config.requestLabel || 'Profi-Montage-Anfrage aus dem Warenkorb', ''];
      if (data.message) body.push('NACHRICHT', data.message, '');
      body.push('WARENKORB', cartText, '', 'Seite: ' + window.location.href);
      fields.push(['contact[body]', body.join('\n')]);
      var a = attribution();
      Object.keys(a).forEach(function (k) { fields.push(['contact[' + k + ']', a[k]]); });
      return fields;
    }

    function postAsPage(fields, pending) {
      try { sessionStorage.setItem(PENDING_KEY, JSON.stringify(Object.assign({ at: Date.now() }, pending))); } catch (e) {}
      var f = document.createElement('form');
      f.method = 'POST'; f.action = '/contact'; f.acceptCharset = 'UTF-8'; f.style.display = 'none';
      fields.forEach(function (pair) {
        var i = document.createElement('input'); i.type = 'hidden'; i.name = pair[0]; i.value = pair[1] == null ? '' : pair[1]; f.appendChild(i);
      });
      document.body.appendChild(f);
      f.submit();
    }

    if (leadForm) {
      // Clear a field's error as soon as the customer corrects it
      ['input', 'change'].forEach(function (type) {
        leadForm.addEventListener(type, function (e) {
          var name = e.target.dataset && e.target.dataset.bzField;
          if (!name) return;
          var err = $('[data-bz-field-error="' + name + '"]');
          if (err) err.textContent = '';
          e.target.classList.remove('is-invalid');
          e.target.removeAttribute('aria-invalid');
          if (name === 'consent') $('[data-bz-consent-box]').classList.remove('has-error');
        });
      });

      leadForm.addEventListener('submit', function (e) {
        e.preventDefault();
        var submit = $('[data-bz-submit]');
        var sendError = $('[data-bz-send-error]');
        if (submit.disabled) return;
        if (!validate()) return;
        if ($('[data-bz-trap]').value) { openModal(true); return; } // drop bots quietly

        submit.disabled = true;
        submit.textContent = 'Wird gesendet…';
        sendError.hidden = true;

        var data = { name: value('name'), email: value('email'), phone: value('phone'), plz: value('plz'), message: value('message') };
        var requestId = 'cart-' + Date.now();

        fetchCart()
          .catch(function () { return cartSnapshot || { items: [], total_price: 0 }; })
          .then(function (cart) {
            var fields = shopifyFields(data, buildCartText(cart));
            var pending = { requestId: requestId, total: cart.total_price, email: data.email };
            return fetch('/contact', {
              method: 'POST',
              headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' },
              body: new URLSearchParams(fields).toString()
            }).then(function (res) {
              if (res.ok && /contact_posted=true/.test(res.url || '')) {
                openModal(true, data.email);
                trackLead(requestId, cart.total_price);
                submit.disabled = false; submit.textContent = 'Anfrage senden →';
                return;
              }
              // Spam protection (captcha) or another check: hand over to a normal
              // form post; Shopify returns here with ?contact_posted=true
              console.warn('[Beratung] Shopify did not confirm the background submit, using a page submit instead.', { status: res.status, url: res.url });
              postAsPage(fields, pending);
            });
          })
          .catch(function () {
            sendError.textContent = 'Die Anfrage konnte nicht gesendet werden. Bitte prüfen Sie Ihre Internetverbindung oder rufen Sie uns an.';
            sendError.hidden = false;
            submit.disabled = false; submit.textContent = 'Anfrage senden →';
          });
      });
    }

    // Back from Shopify's contact form after a page submit (captcha): thank-you + conversion, once
    (function confirmReturn() {
      var params;
      try { params = new URLSearchParams(window.location.search); } catch (e) { return; }
      if (params.get('contact_posted') !== 'true') return;
      var pending = null;
      try { pending = JSON.parse(sessionStorage.getItem(PENDING_KEY) || 'null'); sessionStorage.removeItem(PENDING_KEY); } catch (e) {}
      if (!pending || Date.now() - pending.at > 30 * 60 * 1000) return;
      try {
        params.delete('contact_posted');
        var qs = params.toString();
        var hash = /^#contact_form$/.test(window.location.hash) ? '' : window.location.hash;
        window.history.replaceState(null, '', window.location.pathname + (qs ? '?' + qs : '') + hash);
      } catch (e) {}
      openModal(true, pending.email);
      trackLead(pending.requestId, pending.total);
    })();
  })();
</script>

