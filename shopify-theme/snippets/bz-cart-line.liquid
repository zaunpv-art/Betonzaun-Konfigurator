{%- comment -%}
  One product line of the "Warenkorb (Betonzaun)" section (sections/betonzaun-cart.liquid).

  Accepts:
  - item: {Object} cart line item
  - in_set: {Boolean} the line belongs to a configurator set — its label and
    selections are shown once in the set heading, so they are not repeated here

  Usage:
  {% render 'bz-cart-line', item: item, in_set: true %}
{%- endcomment -%}
<div class="bz-line{% if in_set %} bz-line--in-set{% endif %}" data-bz-line="{{ item.key }}">
  <div class="bz-line__product">
    <a href="{{ item.url }}" class="bz-line__media" tabindex="-1" aria-hidden="true">
      {%- if item.image -%}
        <img
          src="{{ item.image | image_url: width: 240 }}"
          alt="{{ item.image.alt | escape }}"
          width="120"
          height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
          loading="lazy"
        >
      {%- endif -%}
    </a>

    <div class="bz-line__info">
      <a href="{{ item.url }}" class="bz-line__title">{{ item.product.title | escape }}</a>

      {%- unless item.product.has_only_default_variant -%}
        {%- for option in item.options_with_values -%}
          <p class="bz-line__meta">{{ option.name | escape }}: {{ option.value | escape }}</p>
        {%- endfor -%}
      {%- endunless -%}

      {%- unless in_set -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <p class="bz-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}

      {%- for discount in item.line_level_discount_allocations -%}
        <p class="bz-line__discount">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>
      {%- endfor -%}

      <button
        type="button"
        class="bz-line__remove"
        data-bz-remove="{{ item.key }}"
        aria-label="{{ item.product.title | escape }} entfernen"
      >
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
          <circle cx="12" cy="12" r="10.5" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8.5 8.5l7 7M15.5 8.5l-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="bz-line__price">
    <span class="bz-line__label">Preis</span>
    {%- if item.original_price != item.final_price -%}
      <s class="bz-line__old">{{ item.original_price | money_with_currency }}</s>
    {%- endif -%}
    <span>{{ item.final_price | money_with_currency }}</span>
  </div>

  <div class="bz-line__qty">
    <div class="bz-qty">
      <button type="button" class="bz-qty__btn" data-bz-step="-1" data-bz-key="{{ item.key }}" aria-label="Anzahl verringern">−</button>
      <input
        class="bz-qty__input"
        type="number"
        min="0"
        inputmode="numeric"
        value="{{ item.quantity }}"
        data-bz-qty="{{ item.key }}"
        aria-label="Anzahl {{ item.product.title | escape }}"
      >
      <button type="button" class="bz-qty__btn" data-bz-step="1" data-bz-key="{{ item.key }}" aria-label="Anzahl erhöhen">+</button>
    </div>
  </div>

  <div class="bz-line__total">
    <span class="bz-line__label">Gesamtsumme</span>
    <span>{{ item.final_line_price | money_with_currency }}</span>
  </div>

  <p class="bz-line__error" data-bz-error="{{ item.key }}" role="alert"></p>
</div>
